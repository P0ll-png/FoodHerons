# FoodHerons.Api — environment variable template (PLACEHOLDERS ONLY).
#
# Real values are supplied at runtime via `dotnet user-secrets` (dev) or real
# environment variables (prod). NEVER commit real secrets. Copy to `.env`
# (which is git-ignored) or export these in your shell / hosting platform.
#
# .NET config maps "__" to a nested config key (e.g. ConnectionStrings__Postgres
# -> ConnectionStrings:Postgres).

# Service-role Postgres connection string (bypasses RLS). Include the password.
# REQUIRED: POST /api/orders hits Postgres on its first call, so this MUST be
# supplied at runtime (dotnet user-secrets / env 'ConnectionStrings__Postgres').
# appsettings*.json ships an intentionally empty value and the API now fails fast
# at startup (outside the "Testing" environment) when it is missing/empty.
ConnectionStrings__Postgres=Host=db.YOUR-PROJECT-REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR-DB-PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# Supabase project base URL (used to derive the JWKS/OIDC metadata endpoint).
Supabase__Url=https://YOUR-PROJECT-REF.supabase.co

# JWT issuer + audience. Issuer defaults to {Supabase__Url}/auth/v1 if omitted.
Supabase__Issuer=https://YOUR-PROJECT-REF.supabase.co/auth/v1
Supabase__Audience=authenticated

# Legacy HS256 shared secret. Leave UNSET to use asymmetric JWKS validation
# (derived from Supabase__Url). Set ONLY if your project signs tokens with HS256.
Supabase__JwtSecret=YOUR-SUPABASE-JWT-SECRET

# Optional: service-role key for any Supabase REST admin call (not required by
# the order write path, which uses the Postgres connection above).
Supabase__ServiceRoleKey=YOUR-SERVICE-ROLE-KEY
