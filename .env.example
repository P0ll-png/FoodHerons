# FoodHerons frontend environment variables.
# Copy this file to .env.local (git-ignored) and fill in the real values.
# VITE_SUPABASE_ANON_KEY is the PUBLIC anon/publishable key — it is safe in the
# browser because RLS protects the data. NEVER put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=/api
